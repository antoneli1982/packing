+<script>
+/* ===== Notas / Passagem de Turno — propositalmente sem persistência ===== */
+(function(){
+  'use strict';
+  var notes = []; // somente memória desta aba; NÃO usar localStorage/Firebase/IndexedDB
+  var launch = document.getElementById('sas-notes-launch');
+  var overlay = document.getElementById('sas-notes-overlay');
+  var closeBtn = document.getElementById('sas-notes-close');
+  var editor = document.getElementById('sas-notes-editor');
+  var list = document.getElementById('sas-notes-list');
+  var badge = document.getElementById('sas-notes-badge');
+  var count = document.getElementById('sas-notes-list-count');
+  var toast = document.getElementById('sas-notes-toast');
+  var fromSel = document.getElementById('sas-note-from');
+  var toSel = document.getElementById('sas-note-to');
+  if(!launch || !overlay || !editor) return;
+
+  function pad(n){ return String(n).padStart(2,'0'); }
+  function nowFields(){
+    var d = new Date();
+    document.getElementById('sas-note-date').value = d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
+    document.getElementById('sas-note-time').value = pad(d.getHours())+':'+pad(d.getMinutes());
+  }
+  function guessShift(){
+    var h = new Date().getHours();
+    // aproximação visual: T1 manhã, T2 tarde, T3 noite/madrugada
+    var f = (h>=6 && h<14) ? '1' : (h>=14 && h<22) ? '2' : '3';
+    var t = f==='1'?'2':f==='2'?'3':'1';
+    fromSel.value=f; toSel.value=t;
+  }
+  function showToast(msg){
+    toast.textContent=msg; toast.classList.add('on');
+    clearTimeout(showToast._t); showToast._t=setTimeout(function(){toast.classList.remove('on');},2200);
+  }
+  function openNotes(){
+    overlay.classList.add('on'); overlay.setAttribute('aria-hidden','false');
+    if(!document.getElementById('sas-note-date').value) nowFields();
+    render();
+    setTimeout(function(){ editor.focus(); },80);
+  }
+  function closeNotes(){ overlay.classList.remove('on'); overlay.setAttribute('aria-hidden','true'); }
+
+  function exec(cmd, value){
+    editor.focus();
+    try{ document.execCommand(cmd,false,value||null); }catch(e){}
+  }
+  document.getElementById('sas-notes-toolbar').addEventListener('mousedown', function(e){
+    var b=e.target.closest('[data-cmd]'); if(!b) return;
+    e.preventDefault(); exec(b.dataset.cmd);
+  });
+  document.getElementById('sas-notes-size').addEventListener('change',function(){
+    var px=this.value; editor.focus();
+    try{
+      document.execCommand('fontSize',false,'7');
+      editor.querySelectorAll('font[size="7"]').forEach(function(el){el.removeAttribute('size');el.style.fontSize=px+'px';});
+    }catch(e){}
+  });
+  document.getElementById('sas-notes-color').addEventListener('input',function(){ exec('foreColor',this.value); });
+
+  function isBlank(){
+    return !((editor.innerText||'').replace(/\u00a0/g,' ').trim());
+  }
+  function safeHtml(html){
+    var box=document.createElement('div'); box.innerHTML=html;
+    box.querySelectorAll('script,style,iframe,object,embed,form,input,button,textarea,select').forEach(function(n){n.remove();});
+    box.querySelectorAll('*').forEach(function(el){
+      Array.from(el.attributes).forEach(function(a){
+        if(/^on/i.test(a.name) || a.name==='src' || a.name==='href') el.removeAttribute(a.name);
+      });
+    });
+    return box.innerHTML;
+  }
+  function formatDate(iso){
+    if(!iso) return '';
+    var p=iso.split('-'); return p.length===3 ? p[2]+'/'+p[1]+'/'+p[0] : iso;
+  }
+  function updateBadge(){
+    badge.textContent=notes.length;
+    badge.classList.toggle('on',notes.length>0);
+    count.textContent=notes.length+' '+(notes.length===1?'recado':'recados');
+  }
+  function render(){
+    updateBadge();
+    if(!notes.length){
+      list.innerHTML='<div class="sas-notes-empty">Nenhum recado aguardando leitura.</div>';
+      return;
+    }
+    list.innerHTML='';
+    notes.slice().reverse().forEach(function(n){
+      var card=document.createElement('div'); card.className='sas-note-card';
+      var head=document.createElement('div'); head.className='sas-note-card-head';
+      var meta=document.createElement('div');
+      meta.innerHTML='<div class="sas-note-route">TURNO '+n.from+' → TURNO '+n.to+'</div><div class="sas-note-date">'+formatDate(n.date)+' · '+n.time+'</div>';
+      var ok=document.createElement('button'); ok.type='button'; ok.className='sas-note-ok'; ok.textContent='✓ OK · Lido e finalizar';
+      ok.addEventListener('click',function(){
+        notes=notes.filter(function(x){return x.id!==n.id;});
+        render(); showToast('Recado finalizado e removido.');
+      });
+      head.appendChild(meta); head.appendChild(ok);
+      var body=document.createElement('div'); body.className='sas-note-content'; body.innerHTML=n.html;
+      card.appendChild(head); card.appendChild(body); list.appendChild(card);
+    });
+  }
+
+  document.getElementById('sas-notes-save').addEventListener('click',function(){
+    if(isBlank()){ showToast('Digite o recado antes de salvar.'); editor.focus(); return; }
+    var date=document.getElementById('sas-note-date').value;
+    var time=document.getElementById('sas-note-time').value;
+    if(!date || !time){ nowFields(); date=document.getElementById('sas-note-date').value; time=document.getElementById('sas-note-time').value; }
+    notes.push({id:Date.now()+Math.random(),date:date,time:time,from:fromSel.value,to:toSel.value,html:safeHtml(editor.innerHTML)});
+    editor.innerHTML=''; nowFields();
+    // encadeia o próximo turno automaticamente
+    fromSel.value=toSel.value; toSel.value=fromSel.value==='1'?'2':fromSel.value==='2'?'3':'1';
+    render(); showToast('Recado deixado para o próximo turno.');
+  });
+  document.getElementById('sas-notes-clear').addEventListener('click',function(){ editor.innerHTML=''; editor.focus(); });
+  launch.addEventListener('click',openNotes);
+  closeBtn.addEventListener('click',closeNotes);
+  overlay.addEventListener('click',function(e){ if(e.target===overlay) closeNotes(); });
+  document.addEventListener('keydown',function(e){ if(e.key==='Escape' && overlay.classList.contains('on')) closeNotes(); });
+
+  nowFields(); guessShift(); render();
+})();
+</script>
+
 </body>
 </html>
